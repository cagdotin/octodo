{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "plugins": ["typescript", "react", "react-perf", "jsx-a11y", "import", "vitest", "oxc"],
  "env": {
    "browser": true,
    "node": true
  },
  "options": {
    "typeAware": true
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react-hooks/exhaustive-deps": "off",
    "jsx-a11y/no-autofocus": "off",
    "import/no-unassigned-import": "off",
    "typescript/no-base-to-string": "off",
    "typescript/restrict-template-expressions": "off",
    "typescript/no-floating-promises": "error"
  },
  "ignorePatterns": [
    "dist/**",
    "coverage/**",
    "apps/web/src/routeTree.gen.ts",
    ".agents/skills/**",
    ".claude/**"
  ],
  "overrides": [
    {
      "files": ["apps/web/src/components/ui/**"],
      "rules": {
        "jsx-a11y/prefer-tag-over-role": "off",
        "jsx-a11y/click-events-have-key-events": "off",
        "jsx-a11y/no-noninteractive-element-interactions": "off",
        "jsx-a11y/anchor-has-content": "off"
      }
    },
    {
      "files": ["packages/engine/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "effect",
                "importNames": ["FileSystem"],
                "message": "Only packages/engine/src/storage/ touches the disk; take a Storage instead (docs/architecture.md)."
              },
              {
                "name": "effect/FileSystem",
                "message": "Only packages/engine/src/storage/ touches the disk; take a Storage instead (docs/architecture.md)."
              },
              {
                "name": "node:fs",
                "message": "Only packages/engine/src/storage/ touches the disk; take a Storage instead (docs/architecture.md)."
              },
              {
                "name": "node:fs/promises",
                "message": "Only packages/engine/src/storage/ touches the disk; take a Storage instead (docs/architecture.md)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/engine/src/storage/**"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["packages/contract/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["node:*", "@octodo/engine", "@octodo/engine/*"],
                "message": "The contract runs in the browser too: no Node modules and no engine (decision 0004)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/contract/src/rules.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["node:*", "@octodo/engine", "@octodo/engine/*", "effect", "effect/*"],
                "message": "rules.ts is plain functions the browser imports: no Effect, no Node modules, no engine (decision 0004)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/web/src/**", "apps/desktop/src/preload.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@octodo/contract",
                "allowTypeImports": true,
                "message": "@octodo/contract is Effect Schema code: import only its types here, and values from @octodo/contract/rules."
              }
            ],
            "patterns": [
              {
                "group": ["@octodo/engine", "@octodo/engine/*"],
                "message": "The browser bundle may not hold engine code; talk to the server, and import rules from @octodo/contract/rules (decision 0004)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/web/src/**/*.test.ts", "apps/web/src/**/*.test.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@octodo/engine", "@octodo/engine/*"],
                "message": "The browser bundle may not hold engine code; talk to the server, and import rules from @octodo/contract/rules (decision 0004)."
              }
            ]
          }
        ]
      }
    }
  ]
}
