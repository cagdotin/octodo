{
  "name": "tasksmd",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first task manager where every task is a markdown file with frontmatter.",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @tasksmd/web --filter @tasksmd/desktop dev",
    "dev:web": "pnpm --parallel --filter @tasksmd/server --filter @tasksmd/web dev",
    "build": "pnpm --filter @tasksmd/web build && pnpm --filter @tasksmd/desktop build",
    "tasksmd": "node packages/cli/src/main.ts",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@effect/platform-node": "^4.0.6",
    "@types/node": "^26.0.0",
    "effect": "^4.0.6",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=26.10.0 <27"
  },
  "packageManager": "pnpm@12.9.1"
}
