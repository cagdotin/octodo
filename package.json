{
  "name": "octodo",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first task manager where every task is a markdown file with frontmatter.",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @octodo/web --filter @octodo/desktop dev",
    "dev:web": "pnpm --parallel --filter @octodo/server --filter @octodo/web dev",
    "dev:site": "pnpm --filter @octodo/web exec vite ../site --port 5530 --strictPort",
    "build": "pnpm --filter @octodo/web build && pnpm --filter @octodo/desktop build",
    "octo": "node packages/cli/src/main.ts",
    "lint": "oxlint --deny-warnings apps packages scripts brand",
    "lint:fix": "oxlint --fix --deny-warnings apps packages scripts brand",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p scripts/bench/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "prepare": "lefthook install",
    "brand": "node brand/build.ts",
    "bench": "node scripts/bench/workspace.ts"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.6",
    "@fontsource/geist": "^5.3.0",
    "@types/node": "^26.0.0",
    "@types/opentype.js": "^1.3.10",
    "effect": "4.0.6",
    "lefthook": "^2.2.2",
    "opentype.js": "^2.0.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2001",
    "sharp": "^0.34.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=26.10.0 <27"
  },
  "packageManager": "pnpm@12.9.1"
}
